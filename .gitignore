# Sistema de Gestión de Incapacidades - .gitignore principal

# ===========================================
# Sistema Operativo
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ===========================================
# IDEs y Editores
# ===========================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace

# IntelliJ
.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# ===========================================
# Archivos de entorno y secretos
# ===========================================
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
secrets/
credentials/

# ===========================================
# Logs y archivos temporales
# ===========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp

# ===========================================
# Documentación generada (mantener fuentes)
# ===========================================
# Excluir documentación generada automáticamente
# pero mantener docs/ manualmente escritos

# ===========================================
# Archivos de respaldo
# ===========================================
*.bak
*.backup
*.old
*~

# ===========================================
# Datos sensibles y testing
# ===========================================
# Datos de prueba sensibles
test_data/
dump/
*.sql
*.dump

# Archivos subidos por usuarios (desarrollo)
uploads/
storage/
pdf_documentos/

# ===========================================
# Build y distribución
# ===========================================
dist/
build/
*.tar.gz
*.zip

# ===========================================
# Misceláneos
# ===========================================
.cache/
.temp/
TODO.txt
NOTES.md
scratch/
