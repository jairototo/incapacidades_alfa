{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dbhub_postgres": {
      "type": "local",
      "command": [
        "npx",
        "@bytebase/dbhub@latest",
        "--transport",
        "stdio",
        "--dsn",
        "postgres://postgres:postgres@localhost:5442/incapacidades?sslmode=disable"
      ]
    }
  }
}